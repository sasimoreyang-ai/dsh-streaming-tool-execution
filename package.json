{
  "name": "mindagent-dsh-streaming-tool-execution",
  "version": "0.2.2-rc.1",
  "description": "Overlaps parallel-safe native tool calls with model streaming for DSH 0.2.2-rc.1.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasimoreyang-ai/dsh-streaming-tool-execution.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent-loop",
    "streaming",
    "tools"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "check:install": "node scripts/check-install.mjs"
  }
}
